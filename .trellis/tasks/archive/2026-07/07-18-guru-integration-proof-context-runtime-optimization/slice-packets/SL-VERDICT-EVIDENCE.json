  "invariants": [
    {
      "invariant_id": "INV-RT-006",
      "rule": "RetryIdentity binds the complete unchanged semantic snapshot and rejects missing, extra, malformed, or changed components.",
      "source": "design-package/chapters/verdict-evidence.md",
      "owner": "UNIT-verdict-evidence",
      "positive_case": "Stable components reproduce one identity and every component tamper is rejected.",
      "negative_case": "A partial identity, changed digest, or non-string component is accepted for retry reuse.",
      "route_if_missing": "IMPLEMENT_DEFECT",
      "test_evidence": [
        "identity stability",
        "component tamper matrix"
      ]
    },
    {
      "invariant_id": "INV-RT-007",
      "rule": "Formatting retry evidence is immutable and append-only, and one identity permits at most one serialization-only attempt.",
      "source": "design-package/chapters/verdict-evidence.md",
      "owner": "UNIT-verdict-evidence",
      "positive_case": "Raw artifacts and events persist safely; success writes one final official row and failure writes one final blocked row.",
      "negative_case": "Path escape, overwrite, duplicate artifact, second retry, intermediate official row, or evidence deletion succeeds.",
      "route_if_missing": "IMPLEMENT_DEFECT",
      "test_evidence": [
        "append-only replay",
        "path and overwrite negatives",
        "retry and official row counts"
      ]
    },
    {
      "invariant_id": "INV-RT-008",
      "rule": "Semantic findings, provider failures, missing evidence, and snapshot drift never enter formatting-only retry, while legacy normalization remains unchanged.",
      "source": "design-package/chapters/verdict-evidence.md",
      "owner": "UNIT-verdict-evidence",
      "positive_case": "The classification matrix routes only recoverable envelope errors and all legacy tests pass.",
      "negative_case": "A semantic or provider failure is retried as formatting, source is reread, or the official schema changes.",
      "route_if_missing": "IMPLEMENT_DEFECT",
      "test_evidence": [
        "classification matrix",
        "legacy normalization regression"
      ]
    }
  ]
}
