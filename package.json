{
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm --filter @devsc/trellis-core --fail-if-no-match build && pnpm --filter @devsc/trellis --fail-if-no-match build",
    "build:core": "pnpm --filter @devsc/trellis-core --fail-if-no-match build",
    "build:cli": "pnpm --filter @devsc/trellis --fail-if-no-match build",
    "test": "pnpm --filter @devsc/trellis-core --fail-if-no-match test && pnpm --filter @devsc/trellis --fail-if-no-match test",
    "test:core": "pnpm --filter @devsc/trellis-core --fail-if-no-match test",
    "test:cli": "pnpm --filter @devsc/trellis --fail-if-no-match test",
    "lint": "pnpm --filter @devsc/trellis-core --fail-if-no-match lint && pnpm --filter @devsc/trellis --fail-if-no-match lint",
    "typecheck": "pnpm --filter @devsc/trellis-core --fail-if-no-match build && pnpm --filter @devsc/trellis --fail-if-no-match typecheck",
    "release": "pnpm --filter @devsc/trellis --fail-if-no-match release",
    "release:minor": "pnpm --filter @devsc/trellis --fail-if-no-match release:minor",
    "release:major": "pnpm --filter @devsc/trellis --fail-if-no-match release:major",
    "release:beta": "pnpm --filter @devsc/trellis --fail-if-no-match release:beta",
    "release:rc": "pnpm --filter @devsc/trellis --fail-if-no-match release:rc",
    "release:promote": "pnpm --filter @devsc/trellis --fail-if-no-match release:promote",
    "release:check": "node packages/cli/scripts/release-preflight.js check-versions",
    "release:plan": "node packages/cli/scripts/release-preflight.js publish-plan"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
